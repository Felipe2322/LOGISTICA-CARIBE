/*
  # Evita que el sitio sea embebido en iframes (clickjacking)
  X-Frame-Options: DENY

  # Evita que el navegador adivine el tipo de contenido
  X-Content-Type-Options: nosniff

  # Activa protección XSS en navegadores antiguos
  X-XSS-Protection: 1; mode=block

  # Controla qué información de referencia se envía
  Referrer-Policy: strict-origin-when-cross-origin

  # Permisos de funciones del navegador (cámara, micrófono, etc.)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Fuerza HTTPS por 1 año
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy — controla qué puede cargar la página
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://images.unsplash.com https://i.pravatar.cc https://www.google.com; frame-src https://www.google.com; connect-src 'self';
